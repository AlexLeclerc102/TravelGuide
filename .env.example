# Copier ce fichier en `.env` puis adapter. Ne jamais versionner `.env`.

# PostgreSQL (docker-compose)
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel

# Backend
DATABASE_URL=postgres://travel:change-me@db:5432/travel
BIND_ADDR=0.0.0.0:8080
PUBLIC_ORIGIN=http://localhost:5173
RUST_LOG=info,api=debug

# Routage (Valhalla auto-hébergé, construit à partir de l'extrait OSM Costa Rica)
VALHALLA_URL=http://valhalla:8002
