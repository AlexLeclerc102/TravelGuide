# Copier ce fichier en `.env` puis adapter. Ne jamais versionner `.env`.

# PostgreSQL (docker-compose)
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel
# Port publié sur l'hôte (changer si un PostgreSQL local occupe déjà 5432).
DB_PORT=5432

# Backend
DATABASE_URL=postgres://travel:change-me@db:5432/travel
BIND_ADDR=0.0.0.0:8080
PUBLIC_ORIGIN=http://localhost:5173
# Origines supplémentaires autorisées pour les écritures (ici : la doc interactive de l'API).
EXTRA_ALLOWED_ORIGINS=http://localhost:8080
# `false` uniquement en dev HTTP ; toujours `true` en production (HTTPS).
COOKIE_SECURE=false
RUST_LOG=info,api=debug
# Abonnement simulé : emails recevant le plan organisateur (séparés par des virgules).
# `*` = tout compte créé par inscription (pratique en dev ; les invités restent gratuits).
ORGANIZER_EMAILS=*

# Emails (Mailpit en dev : http://localhost:8025). Sans SMTP_URL, les emails sont journalisés.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=TravelGuide <no-reply@travelguide.local>

# Recherche de lieux (Nominatim, OpenStreetMap). Le contact (email ou URL) est ajouté au
# User-Agent, comme l'exige la politique d'usage du service public (1 requête/s au plus).
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=vous@example.com

# Routage (Valhalla auto-hébergé, construit à partir de l'extrait OSM Costa Rica)
VALHALLA_URL=http://valhalla:8002

# Suggestions de lieux : extrait OSM (celui de Valhalla, monté en lecture seule), importé au
# démarrage s'il a changé. Absent : pas de suggestions.
OSM_EXTRACT=/osm/costa-rica-latest.osm.pbf

# Assistant IA (OpenRouter, https://openrouter.ai/keys). Sans clé : assistant désactivé.
# Voir docs/AI_ASSISTANT.md. Les données du voyage sont envoyées au modèle (hébergeur choisi
# par OpenRouter, sans collecte de données) : restreignez les hébergeurs avec AI_PROVIDERS_ONLY.
OPENROUTER_API_KEY=
AI_MODEL=z-ai/glm-5.3-flash
# Modèle des sous-appels (résumés, extraction de pages, recherche web). Vide : AI_MODEL.
AI_MODEL_SMALL=
# Modèles sélectionnables par conversation (dev / comparaison), séparés par des virgules.
AI_MODELS_ALLOWED=
# Hébergeurs OpenRouter autorisés (slugs, ex. mistral/eu), couverts par un accord de
# traitement des données. Vide : tout hébergeur sans collecte de données.
AI_PROVIDERS_ONLY=
AI_DAILY_BUDGET_USD=0.50
AI_MAX_ROUNDS=8
