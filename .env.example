# Copier ce fichier en `.env` puis adapter. Ne jamais versionner `.env`.

# PostgreSQL (docker-compose)
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel

# Backend
DATABASE_URL=postgres://travel:change-me@db:5432/travel
BIND_ADDR=0.0.0.0:8080
PUBLIC_ORIGIN=http://localhost:5173
# Origines supplémentaires autorisées pour les écritures (ici : la doc interactive de l'API).
EXTRA_ALLOWED_ORIGINS=http://localhost:8080
# `false` uniquement en dev HTTP ; toujours `true` en production (HTTPS).
COOKIE_SECURE=false
RUST_LOG=info,api=debug
# Abonnement simulé : emails recevant le plan organisateur (séparés par des virgules).
# `*` = tout compte créé par inscription (pratique en dev ; les invités restent gratuits).
ORGANIZER_EMAILS=*

# Emails (Mailpit en dev : http://localhost:8025). Sans SMTP_URL, les emails sont journalisés.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=TravelGuide <no-reply@travelguide.local>

# Routage (Valhalla auto-hébergé, construit à partir de l'extrait OSM Costa Rica)
VALHALLA_URL=http://valhalla:8002
